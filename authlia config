server:
  host: 0.0.0.0
  port: 9091

session:
  name: authelia_session
  domain: home.server
  same_site: lax
  expiration: 1h
  inactivity: 5m
  remember_me_duration: 1M

access_control:
  default_policy: deny
  rules:
    - domain: "auth.home.server"
      policy: bypass
    - domain: "*.home.server"
      policy: one_factor

authentication_backend:
  file:
    path: /config/users_database.yml
